<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Sistem Temizleyici</vendor>
  <action id="org.sistemtemizleyici.helper">
    <description>Run system cleanup</description>
    <description xml:lang="tr">Sistem temizliği yap</description>
    <message>Authentication is required to clean system caches and logs</message>
    <message xml:lang="tr">Sistem önbelleklerini ve günlüklerini temizlemek için yönetici şifresi gerekiyor</message>
    <icon_name>edit-clear-all</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/sistem-temizleyici/helper.py</annotate>
  </action>
</policyconfig>
